# Client Environment Variables Example
# Local development
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:5000

# Production (Vercel) values
# NEXT_PUBLIC_API_URL=https://salonbook-server-kniz.onrender.com/api
# NEXT_PUBLIC_BETTER_AUTH_URL=https://salonbook-server-kniz.onrender.com

# Public browser keys only. Never put server secrets (Google client secret,
# JWT secret or Better Auth secret) in this file or any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key
